#!/bin/sh
# Blocks a push that ships a changed plugin with its old version (see scripts/release.py).
# Enabled by install.sh with `git config core.hooksPath .githooks`; bypass only on purpose with --no-verify.
root="$(git rev-parse --show-toplevel)" || exit 1
exec python3 "$root/scripts/release.py" --check --repo "$root"
