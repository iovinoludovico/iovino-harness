{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://appforge.dev/schema/app.schema.json",
  "title": "appforge domain model (app.yaml)",
  "description": "Domain model of an application generated by appforge. Structural rules only: semantic checks (references, reachability, cycles) are done by `appforge validate`.",
  "type": "object",
  "required": [
    "app",
    "entities"
  ],
  "additionalProperties": false,
  "definitions": {
    "ident": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,39}$"
    },
    "label": {
      "description": "A text, or a map locale → text (e.g. {it: Invito, en: Invitation}).",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    },
    "principal": {
      "type": "string",
      "description": "all | creator | admin | <role> | field:<reference field> | email:<address> (notifications only)",
      "pattern": "^(all|creator|[a-z][a-z0-9_]*|field:[a-z][a-z0-9_]*|email:[^\\s@]+@[^\\s@]+)$"
    },
    "principals": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/principal"
      }
    },
    "clause": {
      "type": "object",
      "required": [
        "field",
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "neq",
            "in",
            "not_in",
            "gt",
            "gte",
            "lt",
            "lte",
            "is_true",
            "is_false",
            "is_set",
            "is_empty"
          ]
        },
        "value": {}
      }
    },
    "field": {
      "oneOf": [
        {
          "enum": [
            "string",
            "text",
            "email",
            "url",
            "int",
            "number",
            "money",
            "bool",
            "date",
            "datetime",
            "json"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "string",
                "text",
                "email",
                "url",
                "int",
                "number",
                "money",
                "bool",
                "date",
                "datetime",
                "enum",
                "ref",
                "json"
              ],
              "default": "string"
            },
            "label": {
              "$ref": "#/definitions/label"
            },
            "help": {
              "$ref": "#/definitions/label"
            },
            "required": {
              "type": "boolean"
            },
            "unique": {
              "type": "boolean"
            },
            "list": {
              "type": "boolean",
              "description": "Shown as a column in the generic list"
            },
            "readonly": {
              "type": "boolean",
              "description": "Set only by reactions or hand-written code"
            },
            "default": {},
            "enum": {
              "type": "string",
              "description": "Enum name (type: enum)"
            },
            "to": {
              "type": "string",
              "description": "Target entity or User (type: ref)"
            },
            "many": {
              "type": "boolean",
              "description": "Many-to-many reference (join table)"
            },
            "on_delete": {
              "enum": [
                "cascade",
                "restrict",
                "set_null"
              ]
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            },
            "max_length": {
              "type": "integer",
              "minimum": 1
            },
            "renamed_from": {
              "type": "string",
              "description": "Previous key of this field: the generator renames the column instead of dropping it"
            }
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/definitions/label"
        },
        "kind": {
          "enum": [
            "initial",
            "normal",
            "final"
          ]
        },
        "owner": {
          "$ref": "#/definitions/principals",
          "description": "Who has the record in charge (inbox)"
        },
        "editable_by": {
          "$ref": "#/definitions/principals"
        },
        "color": {
          "type": "string"
        },
        "reminder": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "object",
              "properties": {
                "after_days": {
                  "type": "integer",
                  "minimum": 1
                },
                "template": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "renamed_from": {
          "type": "string",
          "description": "Previous key of this state: records are moved automatically"
        }
      }
    },
    "transition": {
      "type": "object",
      "required": [
        "to"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "$ref": "#/definitions/label"
        },
        "from": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "to": {
          "type": "string"
        },
        "by": {
          "$ref": "#/definitions/principals"
        },
        "trigger": {
          "oneOf": [
            {
              "const": "manual"
            },
            {
              "type": "object",
              "required": [
                "at"
              ],
              "properties": {
                "at": {
                  "type": "string"
                },
                "offset": {
                  "type": "string",
                  "pattern": "^[+-]\\s*\\d+\\s*[dhm]$"
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "comment": {
          "oneOf": [
            {
              "enum": [
                "optional",
                "required",
                "none"
              ]
            },
            {
              "type": "boolean"
            }
          ]
        },
        "condition": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/clause"
          },
          "description": "If false the action is hidden"
        },
        "guard": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/clause"
          },
          "description": "If false the action is blocked, explaining what is missing"
        },
        "emits": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "registry",
            "process"
          ]
        },
        "table": {
          "$ref": "#/definitions/ident"
        },
        "label": {
          "$ref": "#/definitions/label"
        },
        "plural": {
          "$ref": "#/definitions/label"
        },
        "description": {
          "type": "string"
        },
        "code_prefix": {
          "type": "string",
          "pattern": "^[A-Z]{2,6}$"
        },
        "display": {
          "type": "string"
        },
        "scope_field": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "menu": {
          "type": "boolean"
        },
        "order": {
          "type": "integer"
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,39}$"
          },
          "additionalProperties": {
            "$ref": "#/definitions/field"
          }
        },
        "indexes": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "permissions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "read": {
              "$ref": "#/definitions/principals"
            },
            "create": {
              "$ref": "#/definitions/principals"
            },
            "update": {
              "$ref": "#/definitions/principals"
            },
            "delete": {
              "$ref": "#/definitions/principals"
            }
          }
        },
        "workflow": {
          "type": "object",
          "required": [
            "states",
            "transitions"
          ],
          "additionalProperties": false,
          "properties": {
            "states": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/state"
              }
            },
            "transitions": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/definitions/transition"
              }
            }
          }
        }
      }
    },
    "reaction": {
      "type": "object",
      "required": [
        "on",
        "do"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "$ref": "#/definitions/ident"
        },
        "on": {
          "type": "string",
          "description": "Event type, e.g. invitation.transitioned"
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "transition": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "to": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "from": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              ]
            },
            "clauses": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/clause"
              }
            }
          }
        },
        "do": {
          "enum": [
            "notify",
            "set",
            "transition",
            "schedule",
            "broadcast",
            "custom"
          ]
        },
        "to": {
          "$ref": "#/definitions/principals"
        },
        "template": {
          "type": "string"
        },
        "set": {
          "type": "object"
        },
        "transition": {
          "type": "string"
        },
        "event": {
          "type": "string"
        },
        "at": {
          "type": "string",
          "description": "<date field> [+|- N(d|h|m)]"
        },
        "channel": {
          "type": "string"
        },
        "handler": {
          "$ref": "#/definitions/ident"
        }
      }
    }
  },
  "properties": {
    "version": {
      "const": 1
    },
    "app": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,49}$"
        },
        "description": {
          "type": "string"
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z]{2}$"
          },
          "minItems": 1
        },
        "timezone": {
          "type": "string"
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "providers": {
              "type": "array",
              "items": {
                "enum": [
                  "google",
                  "email"
                ]
              }
            },
            "allowed_domains": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "approval": {
              "enum": [
                "manual",
                "auto"
              ]
            },
            "admins": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "events": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "string"
            },
            "type_prefix": {
              "type": "string"
            },
            "retention_days": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "deploy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "string"
            },
            "base_url": {
              "type": "string"
            },
            "platforms": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "roles": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,39}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "$ref": "#/definitions/label"
              },
              "scoped": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "scope": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "entity"
          ],
          "properties": {
            "entity": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "enums": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]{1,39}$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "array"
          },
          {
            "type": "object",
            "properties": {
              "label": {
                "$ref": "#/definitions/label"
              },
              "values": {
                "type": "array"
              },
              "labels": {
                "type": "object"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "entities": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Z][A-Za-z0-9]{1,39}$"
      },
      "additionalProperties": {
        "$ref": "#/definitions/entity"
      }
    },
    "events": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string"
              },
              "entity": {
                "type": "string"
              },
              "category": {
                "enum": [
                  "domain",
                  "workflow"
                ]
              }
            }
          }
        ]
      }
    },
    "reactions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/reaction"
      }
    },
    "subscriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "url_env": {
            "type": "string"
          },
          "events": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}