{
  "name": "{{APP_SLUG}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{APP_DESCRIPTION}}",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-http-header-size=65536' next dev",
    "build": "next build",
    "start": "NODE_OPTIONS='--max-http-header-size=65536' next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "check:model": "node scripts/check-model.mjs",
    "worker": "tsx --env-file-if-exists=.env.local worker/dispatcher.ts",
    "worker:dev": "tsx watch --env-file-if-exists=.env.local worker/dispatcher.ts",
    "test": "vitest run",
    "test:db": "supabase test db",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/database.types.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "next-intl": "^4.14.9",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.9"
  }
}
