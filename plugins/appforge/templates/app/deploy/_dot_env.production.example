# Variables for deploy/docker-compose.prod.yml (a .env next to the compose file, or your Docker manager form).

# --- Web (NEXT_PUBLIC_* are also baked into the browser bundle at build time, from GitHub repository Variables)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon / publishable key>
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS={{ALLOWED_DOMAINS}}

# Public URL: auth redirects (web) and links in the events (dispatcher)
APP_BASE_URL={{BASE_URL}}

# --- Webhook dispatcher
# Session pooler (port 5432): LISTEN/NOTIFY does not work through the transaction pooler (6543). TLS required.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DISPATCHER_POLL_INTERVAL_MS=30000

# --- Host
PROXY_NETWORK=nginx-proxy
DOCKER_CONFIG_DIR=/root/.docker
# Rollback: sha-<commit>
APP_TAG=latest
